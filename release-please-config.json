{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "release-type": "simple",
      "extra-files": [
        {
          "type": "json",
          "path": "backend/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "backend/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "backend/package-lock.json",
          "jsonpath": "$.packages[''].version"
        }
      ]
    }
  }
}
